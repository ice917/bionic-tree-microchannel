\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage{botex}

\def\@false{false}
\def\@true{true}

\def\@needsamssymb{true}
\def\@needsamsmath{true}
\def\@needsulem{true}

\def\@natbibnum{true}
	
\def\@elsart{false}
\def\@isdraft{false}
\def\@needstheorems{false}
\def\@needsittheorems{false}
\def\@needsamsthm{false}
\def\@needsgeometry{false}
\def\@needsnatbib{false}

\DeclareOption{no-amsmath}{
	\def\@needsamssymb{false}
	\def\@needsamsmath{false}
}

%\DeclareOption{no-natbib}{
%     \def\@needsnatbib{false}
%}

%% --- natbib stuff
\DeclareOption{authoryear}{
	\def\@needsnatbib{true}
	\def\@natbibnum{false}
}
\ifx\@natbibnum\@true
	\PassOptionsToPackage{sort&compress,numbers}{natbib}
\else
	\PassOptionsToPackage{authoryear}{natbib}
\fi
%% ---
\PassOptionsToPackage{normalem}{ulem}

\DeclareOption{dis-report}{
	\def\@needsgeometry{true}
	\PassOptionsToPackage{paperwidth=17cm,paperheight=24cm}{geometry}
}
\DeclareOption{soda}{
     \def\@needsgeometry{true}
     \PassOptionsToPackage{letterpaper,hmargin=1in,vmargin=1in,footskip=36pt}{geometry}
}
\DeclareOption{stdsize}{
	\def\@needsgeometry{true}
	\PassOptionsToPackage{a4paper,hmargin=3cm,vmargin=3.3cm,heightrounded}{geometry}
}

\DeclareOption{draft}{
	\def\@isdraft{true}
}

\DeclareOption{thm}{
	\def\@needstheorems{true}
	\def\@needsamsthm{true}
}
\DeclareOption{thm-it}{
	\def\@needsittheorems{true}
	\def\@needsamsthm{true}
}

\DeclareOption{elsart}{
	\def\@elsart{true}
}

\ProcessOptions\relax

\newcommand{\@condload}[2]{
	\ifx#1\@true
		\RequirePackage{#2}
	\else
		\relax
	\fi
}

\@condload{\@needsamssymb}{amssymb}
\@condload{\@needsamsmath}{amsmath}
\@condload{\@needsamsthm}{amsthm}
\@condload{\@needsnatbib}{natbib}
\@condload{\@needsgeometry}{geometry}
\@condload{\@needsulem}{ulem}
\@condload{\@needsalgorithm}{algorithm}


%%
%% New commands
%%

%% Number Sets
\newcommand{\setshook}[1]{\mathbb{#1}}
\newcommand{\Nat}{\ensuremath{\setshook{N}}}
\newcommand{\Int}{\ensuremath{\setshook{Z}}}
\newcommand{\PosInt}{\ensuremath{\Int_+}}
\newcommand{\Real}{\ensuremath{\setshook{R}}}
\newcommand{\PosReal}{\ensuremath{\Real_+}}
\newcommand{\Rat}{\ensuremath{\setshook{Q}}}
\newcommand{\PosRat}{\ensuremath{\Rat_+}}
\newcommand{\Compl}{\ensuremath{\setshook{C}}}

%% Logic
\newcommand{\loghook}[1]{\mathtt{#1}}
\newcommand{\true}{\ensuremath{\loghook{true}}}
\newcommand{\false}{\ensuremath{\loghook{false}}}

%\newcommand{\defineconnectives}{
\newcommand{\lognot}{\ensuremath{\neg}}
\newcommand{\logand}{\ensuremath{\wedge}}
\newcommand{\logor}{\ensuremath{\vee}}
\newcommand{\logxor}{\ensuremath{\oplus}}
\newcommand{\logimpl}{\ensuremath{\rightarrow}}
\newcommand{\logeq}{\ensuremath{\leftrightarrow}}
\newcommand{\negate}[1]{\overline{#1}} %% negation bar
%}

%% Complexity Classes
\newcommand{\cchook}[1]{\mathsf{#1}}
\newcommand{\@complexityclass}[1]{\ensuremath{\cchook{#1}}}
\newcommand{\complexityclass}[2]{\newcommand{#1}{\@complexityclass{#2}}}

\newcommand{\@ccmake}[2]{
	\expandafter\newcommand\expandafter{\csname cc#1\endcsname}{\@complexityclass{#2}}
}

\@ccmake{p}{P}
\@ccmake{np}{NP}
\@ccmake{conp}{coNP}
\@ccmake{pspace}{PSPACE}

\newcommand{\defineclasses}{
\@ccmake{nc}{NC}
\@ccmake{ac}{AC}
\@ccmake{rnc}{RNC}
\@ccmake{l}{L}
\@ccmake{nl}{NL}
%%
\@ccmake{exp}{EXP}
\@ccmake{ph}{PH}
\@ccmake{r}{R}
\@ccmake{sharpp}{\#P}
\@ccmake{pls}{PLS}
%%
\@ccmake{zpp}{ZPP}
\@ccmake{rp}{RP}
\@ccmake{corp}{coRP}
\@ccmake{bpp}{BPP}
\@ccmake{pp}{PP}
%%
\@ccmake{po}{PO}
\@ccmake{npo}{NPO}
\@ccmake{apx}{APX}
\@ccmake{ptas}{PTAS}
\@ccmake{fptas}{FPTAS}
}

%% Operators and "bracket functions" (requires amsmath)
\ifx\@needsamsmath\@false\relax\else
	\DeclareMathOperator*{\pr}{Pr} %% actually it's already defined as "\Pr"...
	\DeclareMathOperator{\ex}{\mathbb{E}}
	%% Alternative definitions: 
	%\def\pr[#1]{\mathbf{Pr}\!\left[#1\right]}
	%\def\ex[#1]{\mathbb{E}\!\left[#1\right]}
	\DeclareMathOperator*{\argmin}{argmin}
	\DeclareMathOperator*{\argmax}{argmax}
	\DeclareMathOperator{\sgn}{sgn}
	\newcommand{\abs}[1]{\left| #1 \right|}
	% Matrix operators: 
	\DeclareMathOperator{\trace}{tr}
	\DeclareMathOperator{\rank}{rank}
	%% Flexible definition for \norm :
	\def\normop[#1]#2{\left\| #2 \right\|_{#1}}
	\def\normnoop#1{\left\| #1 \right\|}
	\def\norm{\@ifnextchar[\normop\normnoop}
	%%%% old def: \newcommand{\norm}[1]{\left\| #1 \right\|}
	\newcommand{\floor}[1]{\left\lfloor #1 \right\rfloor}
	\newcommand{\ceil}[1]{\left\lceil #1 \right\rceil}
	\newcommand{\nrst}[1]{\left\lceil #1 \right\rfloor}
	\newcommand{\card}[1]{\left| #1 \right|}
	\newcommand{\latop}[2]{\genfrac{}{}{0pt}{}{#1}{#2}}
	%% Inner product
	\newcommand{\innprod}[2]{\langle #1, #2 \rangle}
\fi

%% Abbreviations
\newcommand{\eps}{\epsilon}

%% Fix for citations after theorems
\newcommand{\thmfix}{$\!\!$}

%% Colored text shortcuts
\newcommand{\colblack}[1]{{\color{black}#1}}
\newcommand{\colred}[1]{{\color{red}#1}}
\newcommand{\colgreen}[1]{{\color{green!50!black}#1}}
\newcommand{\colblue}[1]{{\color{blue}#1}}
\newcommand{\colteal}[1]{{\color{teal}#1}}

%%
%% Theorem-like environments (requires amsthm)
%%
\ifx\@needstheorems\@false\relax\else
	\theoremstyle{plain} 
		\newtheorem{theorem}{Theorem}[section]
		\newtheorem{lemma}[theorem]{Lemma}
		\newtheorem{corollary}[theorem]{Corollary}
		\newtheorem{proposition}[theorem]{Proposition}
		\newtheorem{conjecture}[theorem]{Conjecture}
	\theoremstyle{definition} 
		\newtheorem{definition}{Definition}[section]
		\newtheorem{example}[definition]{Example}
		\newtheorem{problem}[definition]{Problem}
		\newtheorem{exercise}{Exercise}[section]
	\theoremstyle{remark}
		\newtheorem{remark}{Remark}[section]
		\newtheorem{note}[remark]{Note}
		\newtheorem{claim}[remark]{Claim}
		\newtheorem{case}[remark]{Case}
	\newenvironment{proof*}[1]{\begin{proof}[#1]}{\end{proof}}
\fi
\ifx\@needsittheorems\@false\relax\else
	\theoremstyle{plain} 
		\newtheorem{theorem}{Teorema}[section]
		\newtheorem{lemma}[theorem]{Lemma}
		\newtheorem{corollary}[theorem]{Corollario}
		\newtheorem{proposition}[theorem]{Proposizione}
		\newtheorem{conjecture}[theorem]{Congettura}
	\theoremstyle{definition} 
		\newtheorem{definition}{Definizione}[section]
		\newtheorem{example}[definition]{Esempio}
		\newtheorem{problem}[definition]{Problema}
		\newtheorem{exercise}{Esercizio}[section]
	\theoremstyle{remark}
		\newtheorem{remark}{Osservazione}[section]
		\newtheorem{note}[remark]{Nota}
		\newtheorem{claim}[remark]{Affermazione}
		\newtheorem{case}[remark]{Caso}
	\newenvironment{proof*}[1]{\begin{proof}[#1]}{\end{proof}}
\fi

%%
%% Implementation through elsart document class
%%
\ifx\@elsart\@false\relax\else
	\newenvironment{theorem}{\begin{thm}}{\end{thm}}
	\newenvironment{lemma}{\begin{lem}}{\end{lem}}
	\newenvironment{corollary}{\begin{cor}}{\end{cor}}
	\newenvironment{proposition}{\begin{prop}}{\end{prop}}
	\newenvironment{conjecture}{\begin{conj}}{\end{conj}}
	\newenvironment{definition}{\begin{defn}}{\end{defn}}
	\newenvironment{example}{\begin{exmp}}{\end{exmp}}
	\newenvironment{problem}{\begin{prob}}{\end{prob}}
	\newenvironment{remark}{\begin{rem}}{\end{rem}}
	%% The following names already coincide!
	%\newenvironment{note}{\begin{note}}{\end{note}}
	%\newenvironment{claim}{\begin{claim}}{\end{claim}}
	%\newenvironment{case}{\begin{case}}{\end{case}}
	%%
	\newenvironment{proof}{\begin{pf}}{\flushright\qed\end{pf}}
	\newenvironment{proof*}[1]{\begin{pf*}{#1}}{\flushright\qed\end{pf*}}
\fi

%%
%% Front matter commands (already provided by elsart)
%%
\ifx\@elsart\@true\relax\else
	%\newenvironment{frontmatter}{}{\maketitle}
	\newenvironment{keyword}{Keywords: }{}
\fi

%%
%% Draft-only comments & editorial markup
%%
\ifx\@isdraft\@false
	\newcommand{\sidenote}[1]{}
	\newcommand{\add}[1]{#1}
	\newcommand{\remove}[1]{}
	\newcommand{\change}[2]{#2}
\else
	\newcommand{\sidenote}[1]{\mbox{}\marginpar{\raggedright\hspace{0pt}\scriptsize\textsf{#1}}}
	\newcommand{\add}[1]{\uuline{#1}}
	\newcommand{\remove}[1]{\sout{#1}}
	\newcommand{\change}[2]{\remove{#1}\,\add{#2}}
\fi



%%
%% Front Matter commands: case of plain LaTeX (e.g., article class)
%%
\newcommand{\Title}[1]{\title{#1}}
\newcount\ThanksCount
\ThanksCount=0

%\newcommand{\@ifundef}[3]{
%	\expandafter\ifx\csname#1\endcsname\relax#2\else#3\fi
%}
\def\@ifundef#1#2#3{\expandafter\ifx\csname#1\endcsname\relax#2\else#3\fi}

%\newcommand{\@setdef}[2]{
%	\expandafter\def\csname#1\endcsname{#2}
%}
\def\@setdef#1#2{\expandafter\def\csname#1\endcsname{#2}}

%\newcommand{\@getdef}[1]{\csname#1\endcsname}
\def\@getdef#1{\csname#1\endcsname}

\newcommand{\Thanksref}[1]{%
%% search for #1 in dictionary
%% if not present, create it and associate it with a new key value
%% if present, cite (with \footnotemark) corresponding key value
%	\@ifundef{Thanks#1}{NOPE.\@makedef{Thanks#1}{true}}{YEP!}
\@ifundef{Thanks#1}{\advance\ThanksCount by 1\footnotemark[\ThanksCount]\@setdef{Thanks#1}{\ThanksCount}}{\footnotemark[\@getdef{Thanks#1}]}}


